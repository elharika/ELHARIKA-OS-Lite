#!/sbin/sh
set -eu
OUTFD=$2
ZIP=$3
WORK=
MOUNTED_SYSTEM=0
MOUNTED_CACHE=0
ADDED_SCRIPT=0
ADDED_RC=0
ADDED_FLAG=0
COMMITTED=0
UPGRADING=0
MOVED_LOGS=0
ui() { printf 'ui_print %s\nui_print\n' "$*" > "/proc/self/fd/$OUTFD"; }
die() { ui "ERROR: $*"; exit 1; }
cleanup() {
    if [ "$COMMITTED" = 0 ]; then
        if [ "$UPGRADING" = 1 ]; then
            cat "$WORK/previous-script" > "$SCRIPT"
            cat "$WORK/previous-rc" > "$RC"
        else
            [ "$ADDED_SCRIPT" = 0 ] || rm -f "$SCRIPT"
            [ "$ADDED_RC" = 0 ] || rm -f "$RC"
        fi
        [ "$ADDED_FLAG" = 0 ] || rm -f "$CACHE_ROOT/elharika-gpu-capture.request"
        [ "$MOVED_LOGS" = 0 ] || mv "$CACHE_ROOT/elharika-gpu-diagnostics.previous-r2" "$CACHE_ROOT/elharika-gpu-diagnostics"
    fi
    [ "$MOUNTED_SYSTEM" = 0 ] || umount "$WORK/system" || true
    [ "$MOUNTED_CACHE" = 0 ] || umount "$WORK/cache" || true
    [ -z "$WORK" ] || rm -rf "$WORK"
}
trap cleanup EXIT
for tool in getprop readlink mount umount unzip sha256sum awk grep mkdir rm cp cat mv chmod chown sync mktemp; do
    command -v "$tool" >/dev/null 2>&1 || die "Recovery missing $tool"
done
[ "$(getprop ro.product.device)" = v1awifi ] || die 'Only SM-P900/v1awifi is supported'
case "$(getprop ro.bootloader)" in P900*) ;; *) die 'SM-P900 bootloader not verified';; esac
SYSTEM=$(readlink -f /dev/block/platform/dw_mmc.0/by-name/SYSTEM)
CACHE=$(readlink -f /dev/block/platform/dw_mmc.0/by-name/CACHE)
for target in "$SYSTEM" "$CACHE"; do
    case "$target" in /dev/block/mmcblk0p[0-9]*) ;; *) die 'Unexpected block mapping';; esac
    [ -b "$target" ] || die 'Missing block device'
done
[ "$SYSTEM" != "$CACHE" ] || die 'Overlapping partition mappings'
while read -r source mountpoint rest; do
    resolved=$(readlink -f "$source" 2>/dev/null || true)
    [ "$resolved" != "$SYSTEM" ] || die 'Uncheck System in TWRP Mount first'
done < /proc/mounts
WORK=$(mktemp -d /tmp/elharika-gpu-kit.XXXXXX)
mkdir "$WORK/system" "$WORK/cache"
mount -t ext4 -o rw "$SYSTEM" "$WORK/system" || die 'Cannot mount SYSTEM'
MOUNTED_SYSTEM=1
ROOT="$WORK/system/system"
[ -f "$ROOT/build.prop" ] || die 'Expected system-as-root image not found'
grep -qx 'ro.product.system.device=v1awifi' "$ROOT/build.prop" || die 'Wrong installed product'
grep -qx 'ro.build.version.sdk=30' "$ROOT/build.prop" || die 'Wrong Android API'
ACTUAL=$(sha256sum "$ROOT/bin/surfaceflinger" | awk '{print $1}')
[ "$ACTUAL" = @SURFACEFLINGER_SHA@ ] || die 'Installed SurfaceFlinger differs from the diagnosed build'
SCRIPT="$ROOT/bin/elharika-gpu-capture.sh"
RC="$ROOT/etc/init/elharika-gpu-capture.rc"
ui 'ELHARIKA GPU diagnostic installer revision 3: bounded SurfaceFlinger strace'
if [ '@ACTION@' = install ]; then
    [ "$(sha256sum "$ROOT/bin/strace" | awk '{print $1}')" = '3dc25044f47e7d336b4bb990b127af97317fbdb54feb0059217c5b5d31386752' ] || die 'Installed strace differs from diagnosed system'
    if [ -e "$SCRIPT" ] || [ -e "$RC" ]; then
        [ -f "$SCRIPT" ] && [ -f "$RC" ] || die 'Incomplete previous diagnostic installation'
        [ "$(sha256sum "$SCRIPT" | awk '{print $1}')" = '1874b41696592f99f9b58915594cfced81a273881e3f67d9ffd9d81a9e152a6f' ] || die 'Previous collector differs from known r2; no changes made'
        [ "$(sha256sum "$RC" | awk '{print $1}')" = '0f51e0aa4f700d0c68fa64f49ce3400a69dd4b6886d0b2b2c1701a3ba48c461f' ] || die 'Previous init file differs from known r2'
        cp "$SCRIPT" "$WORK/previous-script"
        cp "$RC" "$WORK/previous-rc"
        UPGRADING=1
    fi
    unzip -p "$ZIP" gpu-capture.sh > "$WORK/gpu-capture.sh" || die 'Cannot extract collector'
    unzip -p "$ZIP" gpu-capture.rc > "$WORK/gpu-capture.rc" || die 'Cannot extract init configuration'
    unzip -p "$ZIP" label-copy > "$WORK/label-copy" || die 'Cannot extract label helper'
    echo '@SCRIPT_SHA@  gpu-capture.sh' > "$WORK/SHA256SUMS"
    echo '@RC_SHA@  gpu-capture.rc' >> "$WORK/SHA256SUMS"
    echo '@HELPER_SHA@  label-copy' >> "$WORK/SHA256SUMS"
    (cd "$WORK" && sha256sum -c SHA256SUMS) || die 'Payload checksum failed'
    chmod 0755 "$WORK/label-copy"
else
    # Remove only our exact known files; preserve unexpected user modifications.
    for entry in "$SCRIPT:@SCRIPT_SHA@" "$RC:@RC_SHA@"; do
        path=${entry%:*}; expected=${entry##*:}
        [ ! -e "$path" ] || [ "$(sha256sum "$path" | awk '{print $1}')" = "$expected" ] || die 'Diagnostic file differs; no files removed'
    done
fi
# Reuse only the exact CACHE mount, or mount it privately when not mounted.
CACHE_ROOT=
while read -r source mountpoint rest; do
    resolved=$(readlink -f "$source" 2>/dev/null || true)
    if [ "$resolved" = "$CACHE" ]; then CACHE_ROOT=$mountpoint; fi
done < /proc/mounts
if [ -z "$CACHE_ROOT" ]; then
    mount -t ext4 -o rw "$CACHE" "$WORK/cache" || die 'Cannot mount CACHE'
    MOUNTED_CACHE=1
    CACHE_ROOT="$WORK/cache"
fi
if [ '@ACTION@' = install ]; then
    if [ -e "$CACHE_ROOT/elharika-gpu-diagnostics" ]; then
        [ ! -e "$CACHE_ROOT/elharika-gpu-diagnostics.previous-r2" ] || die 'Existing archived diagnostic directory; no logs overwritten'
        mv "$CACHE_ROOT/elharika-gpu-diagnostics" "$CACHE_ROOT/elharika-gpu-diagnostics.previous-r2"
        MOVED_LOGS=1
    fi
    # Prepare fully labeled files before publishing the init script.
    ADDED_SCRIPT=1
    cp "$WORK/gpu-capture.sh" "$SCRIPT"
    chown 0:0 "$SCRIPT"
    chmod 0755 "$SCRIPT"
    if ! "$WORK/label-copy" "$ROOT/etc/init/hw/init.rc" "$SCRIPT" > "$WORK/label-error.txt" 2>&1; then
        while IFS= read -r line; do ui "$line"; done < "$WORK/label-error.txt"
        die 'Cannot label collector; rollback requested'
    fi
    ADDED_RC=1
    cp "$WORK/gpu-capture.rc" "$RC"
    chown 0:0 "$RC"
    chmod 0644 "$RC"
    if ! "$WORK/label-copy" "$ROOT/etc/init/hw/init.rc" "$RC" > "$WORK/label-error.txt" 2>&1; then
        while IFS= read -r line; do ui "$line"; done < "$WORK/label-error.txt"
        die 'Cannot label init file; rollback requested'
    fi
    ADDED_FLAG=1
    echo ELHARIKA-GPU-CAPTURE-v1 > "$CACHE_ROOT/elharika-gpu-capture.request"
    chmod 0600 "$CACHE_ROOT/elharika-gpu-capture.request"
    ui 'One-boot GPU logging installed. This is a diagnostic, NOT a boot fix.'
    ui 'Reboot System once, wait 90 seconds, return to TWRP and collect /cache/elharika-gpu-diagnostics.'
else
    rm -f "$SCRIPT" "$RC" "$CACHE_ROOT/elharika-gpu-capture.request"
    ui 'Diagnostic service removed. Captured logs were preserved.'
fi
sync
COMMITTED=1
